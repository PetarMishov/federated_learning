POSTGRES_USER=...
POSTGRES_PASSWORD=...
POSTGRES_DB=...
POSTGRES_PORT=...
WEBTOKEN_SECRET=32 character key
# Private local Git storage; defaults to this repository's storage/git/.
# GIT_STORAGE_DIR=/absolute/path/to/storage/git

# Optional GitLab token connector: enable encrypted credential storage.
# CONNECTOR_TOKEN_KEY=<base64-encoded random 32-byte key, e.g. openssl rand -base64 32>
# GITLAB_BASE_URL=https://gitlab.com
